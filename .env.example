# Порт сервера (WebSocket + REST). Frontend (Vite) проксирует на него в dev-режиме.
PORT=8000

# --- Whisper ---
# По умолчанию тут облачный Whisper через OpenAI-совместимый /v1/audio/transcriptions
# (например routerai.ru, model=openai/whisper-large-v3-turbo — дёшево и без CPU-возни).
# Если есть свой self-hosted Whisper — можно подставить его вместо облака, см. ниже.
WHISPER_BASE_URL=https://routerai.ru/api
WHISPER_API_KEY=
WHISPER_MODEL=openai/whisper-large-v3-turbo
# openai  -> POST {WHISPER_BASE_URL}/v1/audio/transcriptions (multipart, как OpenAI API) — облако или self-hosted с таким же контрактом
# asr     -> POST {WHISPER_BASE_URL}/asr (multipart, как openai-whisper-asr-webservice)
# custom  -> POST {WHISPER_BASE_URL} как есть (свой самописный self-hosted сервис, см. README)
WHISPER_PROTOCOL=openai
WHISPER_TIMEOUT_MS=20000

# --- LLM (OpenAI-compatible Chat Completions) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=25000

# Курс для счётчика расходов в правом нижнем углу UI (₽). Провайдеры вроде routerai
# отдают usage.cost в USD прямо в ответе API — тут просто фиксированный курс перевода.
USD_TO_RUB_RATE=80

# --- Только для Docker Compose ---
# Адрес сервера, доступный из браузера (не из контейнера). Нужен, потому что web
# в проде отдаётся статикой без dev-прокси. Для локального docker compose на той же
# машине обычно подходит http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000
